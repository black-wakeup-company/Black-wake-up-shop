rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(storeId, memberUid) {
      return /databases/$(database)/documents/stores/$(storeId)/members/$(memberUid);
    }

    function isActiveMember(storeId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(memberPath(storeId, request.auth.uid))
        && get(memberPath(storeId, request.auth.uid)).data.active == true;
    }

    function memberRole(storeId) {
      return get(memberPath(storeId, request.auth.uid)).data.role;
    }

    function hasRole(storeId, roles) {
      return isActiveMember(storeId) && memberRole(storeId) in roles;
    }

    function isStoreOwner(storeId) {
      return hasRole(storeId, ['owner']) && request.auth.uid == storeId;
    }

    function validEmployeeMember(memberUid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'role', 'displayName', 'email', 'active', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'role', 'displayName', 'email', 'active', 'createdAt'
        ])
        && request.resource.data.uid == memberUid
        && request.resource.data.role in ['manager', 'cashier']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.active is bool;
    }

    match /stores/{storeId} {
      // The owner may read the exact store document addressed by their UID
      // during first provisioning; active members may read their store.
      allow get: if (signedIn() && request.auth.uid == storeId) || isActiveMember(storeId);
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == storeId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'ownerEmail', 'createdAt', 'schemaVersion'
        ])
        && request.resource.data.schemaVersion == 1;

      allow update: if isStoreOwner(storeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == resource.data.schemaVersion;

      allow delete: if false;

      match /members/{memberUid} {
        // Members can read only their own membership; owners can list members.
        allow get: if (signedIn() && memberUid == request.auth.uid) || isStoreOwner(storeId);
        allow list: if isStoreOwner(storeId);

        // Initial owner membership is created atomically with the store.
        allow create: if (
            signedIn()
            && request.auth.uid == storeId
            && memberUid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.active == true
            && getAfter(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid
          ) || (
            isStoreOwner(storeId)
            && memberUid != request.auth.uid
            && validEmployeeMember(memberUid)
          );

        // Owner can update employee role/status, never the owner membership.
        allow update: if isStoreOwner(storeId)
          && memberUid != request.auth.uid
          && validEmployeeMember(memberUid)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isStoreOwner(storeId) && memberUid != request.auth.uid;
      }

      match /products/{documentId} {
        allow read: if isActiveMember(storeId);
        allow create, update: if hasRole(storeId, ['owner', 'manager']);
        allow delete: if hasRole(storeId, ['owner', 'manager']);
      }

      // Stock movements are append-only audit records. Quantities are never
      // overwritten here; a later sync process can reconcile each movement.
      match /stockMovements/{movementId} {
        allow read: if isActiveMember(storeId);
        allow create: if hasRole(storeId, ['owner', 'manager', 'cashier'])
          && request.resource.data.keys().hasOnly([
            'id', 'productId', 'quantityDelta', 'reason', 'referenceId', 'createdAt', 'createdBy'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'productId', 'quantityDelta', 'reason', 'createdAt', 'createdBy'
          ])
          && request.resource.data.id == movementId
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.quantityDelta is number
          && request.resource.data.quantityDelta != 0
          && request.resource.data.reason in ['sale', 'refund', 'restock', 'adjustment']
          && request.resource.data.createdAt is string
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /customers/{documentId} {
        allow read: if isActiveMember(storeId);
        allow create, update: if hasRole(storeId, ['owner', 'manager', 'cashier']);
        allow delete: if hasRole(storeId, ['owner', 'manager']);
      }

      match /sales/{documentId} {
        allow read: if isActiveMember(storeId);
        allow create: if hasRole(storeId, ['owner', 'manager', 'cashier']);
        allow update: if hasRole(storeId, ['owner', 'manager']);
        allow delete: if hasRole(storeId, ['owner']);
      }

      match /expenses/{documentId} {
        allow read, create, update: if hasRole(storeId, ['owner', 'manager']);
        allow delete: if hasRole(storeId, ['owner']);
      }

      match /cashSessions/{documentId} {
        allow read: if isActiveMember(storeId);
        allow create, update: if hasRole(storeId, ['owner', 'manager', 'cashier']);
        allow delete: if hasRole(storeId, ['owner']);
      }

      match /settings/{documentId} {
        allow read: if isActiveMember(storeId);
        allow create, update: if hasRole(storeId, ['owner']);
        allow delete: if hasRole(storeId, ['owner']);
      }

      // Deny every not-yet-defined nested path by default.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
