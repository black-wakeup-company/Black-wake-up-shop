rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStoreOwner(storeId) {
      return signedIn()
        && request.auth.uid == storeId
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data.active == true;
    }

    match /stores/{storeId} {
      // The owner may read the exact store document addressed by their own UID.
      // This permits the first provisioning transaction to read a missing doc.
      allow get: if signedIn() && request.auth.uid == storeId;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == storeId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'ownerEmail', 'createdAt', 'schemaVersion'
        ])
        && request.resource.data.schemaVersion == 1;

      allow update: if isStoreOwner(storeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if false;

      match /members/{memberUid} {
        // The owner may read only their own membership doc during first setup.
        allow get: if signedIn()
          && request.auth.uid == storeId
          && memberUid == request.auth.uid;
        allow list: if isStoreOwner(storeId);

        // Initial owner membership must be created atomically with its store.
        allow create: if signedIn()
          && request.auth.uid == storeId
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && request.resource.data.active == true
          && getAfter(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;

        allow update, delete: if false;
      }

      // Business data remains denied until collection- and role-specific rules
      // are completed and tested.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}